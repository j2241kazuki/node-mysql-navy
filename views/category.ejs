<!DOCTYPE html>
<html>
<head>
    <title>カテゴリ一覧</title>
</head>
<body>
    <h1>カテゴリ一覧</h1>

    <ul>
        <% categories.forEach(function(category) { %>
            <li><%= category.name %></li>
        <% }); %>
    </ul>

    <form action="/categories" method="POST">
        <input type="text" name="name" placeholder="新しいカテゴリ名">
        <button type="submit">追加</button>
    </form>
</body>
</html>
