<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>ダッシュボード</title>
  <style>
    /* ナビゲーションバーのスタイル */
    .navbar {
      background-color: #333;
      overflow: hidden;
      padding: 10px 20px;
    }

    .navbar a {
      float: left;
      color: white;
      text-align: center;
      padding: 10px 16px;
      text-decoration: none;
      font-size: 16px;
    }

    .navbar a:hover {
      background-color: #575757;
    }

    .welcome {
      padding: 20px;
    }
  </style>
</head>
<body>

  <!-- ナビゲーションバー -->
  <div class="navbar">
    <a href="/">ホーム</a>
    <a href="/logout" style="float: right;">ログアウト</a>
  </div>

  <div class="welcome">
    <h1>ようこそ、<%= user.email %> さん！</h1>
    <p>ここはあなたのダッシュボードです。</p>
  </div>

</body>
</html>
