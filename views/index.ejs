<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <% if (user) { %>
    <p>こんにちは、<%= user.username %>さん！</p>
    <form action="/logout" method="post" style="display:inline;">
      <button type="submit">ログアウト</button>
    </form>
  <% } else { %>
    <p><a href="/signin">サインイン</a>してください。</p>
  <% } %>

  <h1>レシピ一覧</h1>
<% if (recipes && recipes.length > 0) { %>
  <ul>
    <% recipes.forEach(recipe => { %>
      <li>
        <h3><%= recipe.title %></h3>
        <p><%= recipe.description %></p>

        <!-- 削除フォーム -->
        <form action="/delete/<%= recipe.id %>" method="POST" onsubmit="return confirm('本当に削除しますか？');">
          <button type="submit">削除</button>
        </form>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>レシピがありません。</p>
<% } %>
  <h2>検索・絞り込み</h2>
  <form method="get" action="/recipes">
    <input type="text" name="q" placeholder="キーワード検索" value="<%= typeof q !== 'undefined' ? q : '' %>">
    <select name="category">
      <option value="">カテゴリ選択</option>
      <% categories.forEach(function(cat) { %>
        <option value="<%= cat.id %>" <%= selectedCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
      <% }); %>
    </select>
    <button type="submit">検索</button>
  </form>

  <ul>
    <% recipes.forEach(function(recipe) { %>
      <li>
        <strong><%= recipe.title %></strong>
        （カテゴリ: <%= recipe.category %>）
        <% if (recipe.image) { %>
          <br><img src="/uploads/<%= recipe.image %>" width="100">
        <% } %>
        
        <% if (user && user.id === recipe.user_id) { %>
          <form action="/recipes/<%= recipe.id %>?_method=DELETE" method="post" style="display:inline;">
            <button type="submit" onclick="return confirm('本当に削除しますか？');">削除</button>
          </form>
        <% } %>
      </li>
    <% }); %>
  </ul>

  <a href="/recipes/new">新規登録</a>
</body>
</html>
